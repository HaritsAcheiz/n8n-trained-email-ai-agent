    {
      "parameters": {
        "jsCode": "let jsonlData = '';\n    for (const item of $input.all()) {\n      if (item.json) {\n        // Stringify the JSON object and add a newline character\n        jsonlData += JSON.stringify(item.json) + '\\n'; \n      }\n    }\n    // Return the combined JSONL string as a binary item\n    return [{ json: {}, binary: { data: Buffer.from(jsonlData, 'utf8') }"
      },
