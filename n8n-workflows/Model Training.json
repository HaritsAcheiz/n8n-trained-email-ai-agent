      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.output = [\n    {\n      \"messages\":[\n        {\n          \"role\": \"system\",\n          \"content\": item.json.systemPrompt\n        },\n        {\n          \"role\": \"user\",\n          \"content\": item.json.userPrompt\n        },\n        {\n          \"role\":\"assistant\",\n          \"tool_calls\":[\n            {\n              \"id\":item.json.toolCallId,\n              \"type\":item.json.toolCallType,\n              \"function\":{\n                \"name\": item.json.toolName,\n                \"arguments\": item.json.toolArgument\n              }\n            }\n          ]\n        },\n        {\n          \"role\": \"tool\",\n          \"tool_call_id\": item.json.toolCallId,\n          \"content\": item.json.toolOutput\n        },\n        {\n          \"role\": \"assistant\",\n          \"content\": item.json.agentResponse\n        }\n      ],\n      \"parallel_tool_calls\":false,\n      \"tools\":[\n        {\n          \"type\": \"function\",\n          \"function\":{\n            \"name\":\"get_product_info_from_sku\",\n            \"description\":\"Call this tool to get product information from Shopify using variant sku or item number\",\n            \"parameters\":{\n              \"type\":\"object\",\n              \"properties\":{\n                \"variantSku\":{\n                  \"type\":\"string\",\n                  \"description\":\"variant SKU or item number, eg. 25-60988\"\n                }\n              },\n              \"required\":[\"variantSku\"]\n            }\n          }\n        }\n      ]\n    }\n  ]\n}\n\nreturn $input.all();"
      },
